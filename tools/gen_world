#!/usr/bin/env python3
"""Regenerates src/worlddata.rs from lazytui's worlddata.h (Natural Earth 1:110m admin-0, public domain).
usage: tools/gen_world [path/to/worlddata.h]   (default: ../lazytui/src/widgets/map/worlddata.h)"""
import re, sys, os
src = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), "../../lazytui/src/widgets/map/worlddata.h")
t = open(src, encoding="utf-8").read()
conts = re.search(r"#define WCONTINENTS \{(.*?)\}", t).group(1)
countries = re.findall(r'\{"(\w+)", "([^"]*)", "([^"]*)", ([-\d.]+)f, ([-\d.]+)f, ([-\d.]+)f, (\d+), ([-\d.]+)f, ([-\d.]+)f, (\d+), (\d+), (\d+)\}', t)
rings = re.findall(r"\{(\d+),(\d+),(\d)\}", t.split("WRINGS")[1].split("WVERTS")[0])
verts = [int(x) for x in re.findall(r"-?\d+", t.split("WVERTS[")[1].split("{", 1)[1].split("};")[0])]
assert len(countries) == int(re.search(r"WNCOUNTRIES (\d+)", t).group(1)), len(countries)
assert len(verts) % 2 == 0 and all(s + n <= len(verts) // 2 for s, n, _ in map(lambda r: tuple(map(int, r)), rings))
o = ["//! GENERATED by tools/gen_world from Natural Earth 1:110m admin-0 countries (public domain, naturalearthdata.com). Do not edit.",
     "//! Vertices are lon*100, lat*100 as i16 pairs; a ring is (first vertex, count); a country owns `nrings` rings from `ring0`.", "",
     f"pub const CONTINENTS: [&str; {len(conts.split(','))}] = [{conts.strip()}];", "",
     "pub struct Country { pub iso: &'static str, pub en: &'static str, pub pl: &'static str, pub lx: f32, pub ly: f32, pub minlabel: f32, pub rank: u8, pub pop_m: f32, pub gdp_bn: f32, pub continent: u8, pub ring0: u16, pub nrings: u16 }", "",
     f"pub const COUNTRIES: [Country; {len(countries)}] = ["]
for c in countries:
    o.append('    Country { iso: "%s", en: "%s", pl: "%s", lx: %s, ly: %s, minlabel: %s, rank: %s, pop_m: %s, gdp_bn: %s, continent: %s, ring0: %s, nrings: %s },' % c)
o += ["];", "", f"pub const RINGS: [(u32, u32); {len(rings)}] = ["]
o.append("    " + ", ".join(f"({a}, {b})" for a, b, _ in rings) + ",")
o += ["];", "", f"pub const VERTS: [i16; {len(verts)}] = ["]
for i in range(0, len(verts), 16):
    o.append("    " + ", ".join(map(str, verts[i:i + 16])) + ",")
o.append("];")
open(os.path.join(os.path.dirname(__file__), "../src/worlddata.rs"), "w", encoding="utf-8").write("\n".join(o) + "\n")
print(len(countries), "countries", len(rings), "rings", len(verts) // 2, "vertices")
